// ggml's base (CMake's ggml-base target), unchanged from llama.cpp,
// built by goose build. Not with -march=native, as CMake builds it: gcc
// would fuse multiply-adds in the reference quantizers, and their results
// would differ from llama.cpp's. The CPU backend is ggml/cpu, built native.
c_sources = [
    "src/ggml.c",
    "units/ggml_cxx.cpp",
    "src/ggml-alloc.c",
    "src/ggml-backend.cpp",
    "src/ggml-backend-meta.cpp",
    "src/ggml-opt.cpp",
    "src/ggml-threading.cpp",
    "src/ggml-quants.c",
    "src/gguf.cpp",
];
c_include = ["include", "src", "units"];
c_defines = [
    "GGML_SCHED_MAX_COPIES=4",
    "NDEBUG",
    "_CRT_SECURE_NO_WARNINGS",
    "_XOPEN_SOURCE=600",
];
c_flags_cc = ["-O3"];
c_flags_msvc = ["/O2", "/std:c++17", "/utf-8", "/bigobj"];
c_libs = ["stdc++"];
// goose build links with gcc, which takes the static libgcc, and ggml's
// std::call_once then crashes on MinGW; g++ would take libgcc_s. MinGW gcc only.
c_libs_windows = ["advapi32", "gcc_s"];
